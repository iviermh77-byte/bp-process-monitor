# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se commitea (ver .gitignore).

# --- Base de datos de Blue Prism (usuario de SOLO LECTURA) ---
BP_DB_SERVER=
BP_DB_NAME=
BP_DB_USER=
BP_DB_PASSWORD=
BP_DB_DRIVER="ODBC Driver 17 for SQL Server"

# --- Smartsheet ---
SMARTSHEET_API_KEY=
SMARTSHEET_SHEET_ID=

# --- Ejecución ---
# Minutos entre cada corrida (usado solo si se corre como proceso persistente)
RUN_INTERVAL_MINUTES=15

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
# Semanas de historial a conservar (rotación semanal, domingos a medianoche)
LOG_BACKUP_WEEKS=4
